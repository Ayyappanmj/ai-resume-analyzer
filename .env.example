# Copy to .env and adjust as needed.

# --- LLM (Ollama running on the host or its own container) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT=180

# --- Models ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# --- Optional persistence (leave blank to disable history) ---
DATABASE_URL=postgresql+psycopg2://resume:resume@db:5432/resume

MAX_UPLOAD_MB=5
CORS_ORIGINS=*

# --- Frontend ---
API_URL=http://localhost:8000
