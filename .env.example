# Copy to .env and adjust as needed.

# --- LLM (set your Groq API key; never commit the real key) ---
GROQ_API_KEY=

# --- Optional persistence (leave blank to disable history) ---
DATABASE_URL=postgresql+psycopg2://resume:resume@db:5432/resume

MAX_UPLOAD_MB=5
CORS_ORIGINS=*

# --- Frontend ---
API_URL=http://backend:8000
